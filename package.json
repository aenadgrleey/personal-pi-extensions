{
  "name": "personal-pi-extensions",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "pi-extensions/ask/index.ts",
      "pi-extensions/auto-update/index.ts",
      "pi-extensions/check.ts",
      "pi-extensions/clear-input/index.ts",
      "pi-extensions/codex-swap/index.ts",
      "pi-extensions/cursor/index.ts",
      "node_modules/pi-cursor-sdk/src/index.ts",
      "node_modules/@tunnckocore/pi-gpt-fast-mode/src/index.ts",
      "node_modules/@quintinshaw/pi-dynamic-workflows/extensions/workflow.ts",
      "node_modules/@howaboua/pi-codex-conversion/src/index.ts",
      "node_modules/@teelicht/pi-grepai/src/extension/index.ts",
      "node_modules/pi-mcp-adapter/index.ts",
      "node_modules/pi-sensitive-guard/index.ts",
      "pi-extensions/honcho-memory/index.ts",
      "pi-extensions/indicators.ts",
      "pi-extensions/system-context/index.ts",
      "pi-extensions/notify.ts",
      "pi-extensions/interaction-notifier.ts",
      "pi-extensions/search/index.ts"
    ],
    "skills": []
  },
  "scripts": {
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "test:codex-swap": "bun test pi-extensions/codex-swap/*.test.ts",
    "test:cursor-bridge": "bun test pi-extensions/cursor/*.test.ts",
    "test:indicators": "bun test pi-extensions/indicators.test.ts",
    "check": "bun run format:check && bun run test:codex-swap && bun run test:cursor-bridge && bun run test:indicators && bun build pi-extensions/check.ts --target=node --outfile=/tmp/pi-check-extension.js && bun build pi-extensions/codex-swap/index.ts --target=node --outfile=/tmp/pi-codex-swap-extension.js && bun build pi-extensions/cursor/index.ts --target=node --outfile=/tmp/pi-cursor-bridge-extension.js && bun build pi-extensions/indicators.ts --target=node --outfile=/tmp/pi-indicators-extension.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.78.1",
    "@earendil-works/pi-coding-agent": "^0.78.1",
    "@earendil-works/pi-tui": "^0.78.1",
    "@honcho-ai/sdk": "^2.2.0",
    "@howaboua/pi-codex-conversion": "^1.5.21",
    "@mariozechner/pi-ai": "npm:@earendil-works/pi-ai@^0.78.1",
    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@^0.78.1",
    "@quintinshaw/pi-dynamic-workflows": "^2.12.1",
    "@sinclair/typebox": "npm:typebox@^1.1.38",
    "@teelicht/pi-grepai": "^0.1.1",
    "@tunnckocore/pi-gpt-fast-mode": "^0.4.0",
    "js-yaml": "^4.1.0",
    "pi-cursor-sdk": "^0.1.56",
    "pi-mcp-adapter": "^2.11.0",
    "pi-sensitive-guard": "0.4.2",
    "typebox": "^1.1.38"
  },
  "bundledDependencies": [
    "@tunnckocore/pi-gpt-fast-mode",
    "pi-cursor-sdk"
  ],
  "trustedDependencies": [
    "tree-sitter-bash"
  ]
}
